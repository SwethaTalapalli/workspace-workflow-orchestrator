# ── Gemini / ADK ─────────────────────────
GOOGLE_API_KEY=your_api_key_here
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_REGION=us-central1

# ── Database ─────────────────────────────
DB_MODE=sqlite  # or alloydb

# AlloyDB (only needed for production)
ALLOYDB_INSTANCE_URI=your_instance_uri
ALLOYDB_DB_NAME=productivity_db
ALLOYDB_DB_USER=postgres
ALLOYDB_DB_PASSWORD=your_password

# ── OAuth (local testing only) ───────────
GOOGLE_OAUTH_CREDENTIALS_FILE=app/credentials.json